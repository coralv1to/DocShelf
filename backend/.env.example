# Sao chép thành .env rồi sửa theo máy

# --- Database ---
DATABASE_URL=postgresql+psycopg://docshelf:docshelf_dev_123@127.0.0.1:5433/docshelf

# --- Đăng nhập ---
# Chuỗi bí mật ký token đăng nhập. BẮT BUỘC, >= 32 ký tự. Tạo bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080
# true khi chạy HTTPS thật (production); để false khi chạy local http://localhost
COOKIE_SECURE=false

# --- Model ---
# Dùng 127.0.0.1 thay vì localhost: trên Windows localhost thử IPv6 trước, có thể chậm thêm ~2s mỗi lần kết nối
OLLAMA_HOST=http://127.0.0.1:11434
CHAT_MODEL=qwen3.5:4b
EMBED_MODEL=qwen3-embedding:0.6b
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu
NUM_CTX=8192
THINK=false

# --- Cắt đoạn ---
CHUNK_WORDS=350
CHUNK_OVERLAP_WORDS=40

# --- Tìm kiếm ---
TOP_K_RETRIEVE=8
TOP_K_CONTEXT=4
MIN_VECTOR_SCORE=0.45
MIN_RERANK_SCORE=0.30

# --- Hội thoại ---
HISTORY_TURNS=3

# --- Chế độ trả lời ---
# Chế độ mặc định ban đầu: fast | balanced | accurate. Sau đó admin đổi trong trang Cài đặt.
DEFAULT_MODE=balanced
# Nạp sẵn model + tài liệu khi khởi động backend
WARMUP=true

# --- Cờ nâng cấp (chỉ dùng khi chạy benchmark với cấu hình cũ) ---
USE_BM25=true
USE_RERANK=true
USE_REWRITE=true

DATA_DIR=data

# --- Tối ưu tốc độ / VRAM ---
KEEP_ALIVE=30m
EMBED_NUM_CTX=2048
RERANK_MAX_LENGTH=512
RERANK_TRUST_REMOTE_CODE=false
